//@version=5
indicator("MML Institutional AMT & Execution Sentinel [Sweep SL & Multi-TP]", overlay=true, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 1. تنظیمات سرمایه، ریسک ساختاری و اهداف (CAPITAL & RISK SETTINGS)
// ==============================================================================
grp_cap        = "مدیریت سرمایه و استراکچر ریسک (Capital & Structural Risk)"
account_cap    = input.float(1000.0, "سرمایه اولیه حساب ($)", minval=10.0, group=grp_cap)
risk_pct       = input.float(3.0, "سقف ریسک مجاز در هر معامله (%)", minval=0.5, maxval=10.0, step=0.5, group=grp_cap)
min_rr_ratio   = input.float(1.2, "حداقل نسبت سود به زیان استراکچر تا TP1 (Min R:R)", minval=0.8, maxval=4.0, step=0.1, group=grp_cap)

grp_amt        = "تنظیمات والیوم پروفایل و سوئیپ استراکچر (AMT & Sweep Settings)"
num_bins       = input.int(50, "تعداد لایه‌های هیستوگرام حجم (Price Bins)", minval=20, maxval=80, step=5, group=grp_amt)
va_percent     = input.float(70.0, "درصد محدوده ارزش (Value Area %)", minval=50.0, maxval=85.0, step=5.0, group=grp_amt)
sweep_bars     = input.int(3, "تعداد کندل‌های بررسی سوئیپ نقدینگی (Sweep Bars)", minval=2, maxval=10, group=grp_amt)
atr_sl_mult    = input.float(0.20, "بافر نوسانی استاپ سوئیپ (ATR Buffer)", minval=0.0, maxval=1.0, step=0.05, group=grp_amt)

grp_btc        = "پایشگر متقاطع بیت‌کوین (BTC Cross-Asset Watchdog)"
btc_sym        = input.symbol("BINANCE:BTCUSDT.P", "نماد فیوچرز بیت‌کوین", group=grp_btc)
btc_filter_on  = input.bool(true, "فعال‌سازی فیلتر تله‌های بیت‌کوین (BTC Trap Filter)", group=grp_btc)
btc_vel_thresh = input.float(-0.15, "آستانه افت شدید شتاب بیت‌کوین (%)", group=grp_btc)

grp_score      = "امتیازدهی چندعاملی حراج بازار (AMT Confluence Engine)"
min_score      = input.float(60.0, "حداقل امتیاز تایید ورود (AMT Score %)", minval=40.0, maxval=90.0, step=5.0, group=grp_score)
show_hud       = input.bool(true, "نمایش پنل اطلاعات زنده (Live HUD Table)", group=grp_score)
show_levels    = input.bool(true, "ترسیم سطوح روزانه والیوم پروفایل (POC / VAH / VAL)", group=grp_score)

// ==============================================================================
// 2. محاسبه والیوم پروفایل واقعی روز قبل (TRUE VOLUME PROFILE HISTOGRAM)
// ==============================================================================
var float[] day_volumes = array.new_float(0)
var float[] day_prices  = array.new_float(0)
var float cur_d_high    = high
var float cur_d_low     = low

var float prev_real_poc = na
var float prev_real_vah = na
var float prev_real_val = na

is_new_day = ta.change(time("D")) != 0

if is_new_day
    int bar_count = array.size(day_volumes)
    if bar_count > 10 and cur_d_high > cur_d_low
        float bin_step = (cur_d_high - cur_d_low) / num_bins
        float[] vol_bins = array.new_float(num_bins, 0.0)
        
        for i = 0 to bar_count - 1
            float p = array.get(day_prices, i)
            float v = array.get(day_volumes, i)
            int b_idx = math.floor((p - cur_d_low) / math.max(bin_step, 0.0001))
            b_idx := math.min(math.max(b_idx, 0), num_bins - 1)
            array.set(vol_bins, b_idx, array.get(vol_bins, b_idx) + v)
            
        int poc_idx = array.indexof(vol_bins, array.max(vol_bins))
        prev_real_poc := cur_d_low + (poc_idx + 0.5) * bin_step
        
        float total_vol = array.sum(vol_bins)
        float target_va_vol = total_vol * (va_percent / 100.0)
        float cum_vol = array.get(vol_bins, poc_idx)
        int up_idx = poc_idx
        int down_idx = poc_idx
        
        for step = 0 to num_bins - 1
            if cum_vol >= target_va_vol
                break
            float vol_up = up_idx < num_bins - 1 ? array.get(vol_bins, up_idx + 1) : 0.0
            float vol_down = down_idx > 0 ? array.get(vol_bins, down_idx - 1) : 0.0
            if vol_up >= vol_down and up_idx < num_bins - 1
                up_idx += 1
                cum_vol += vol_up
            else if down_idx > 0
                down_idx -= 1
                cum_vol += vol_down
            else
                break
                
        prev_real_vah := cur_d_low + (up_idx + 1) * bin_step
        prev_real_val := cur_d_low + down_idx * bin_step
        
    array.clear(day_volumes)
    array.clear(day_prices)
    cur_d_high := high
    cur_d_low := low
else
    cur_d_high := math.max(cur_d_high, high)
    cur_d_low := math.min(cur_d_low, low)

array.push(day_volumes, volume)
array.push(day_prices, (high + low + close) / 3.0)

// استخراج دیتای روزانه در اسکوپ سراسری برای شروع ایمن
prev_d_h = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prev_d_l = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
prev_d_c = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

if na(prev_real_poc)
    prev_real_poc := (prev_d_h + prev_d_l + prev_d_c) / 3.0
    prev_real_vah := math.min(prev_d_h, prev_real_poc + (prev_d_h - prev_d_l) * 0.35)
    prev_real_val := math.max(prev_d_l, prev_real_poc - (prev_d_h - prev_d_l) * 0.35)

plot(show_levels ? prev_real_vah : na, "Real Previous Day VAH", color=color.new(#ef4444, 20), linewidth=2, style=plot.style_linebr)
plot(show_levels ? prev_real_poc : na, "Real Previous Day POC", color=color.new(#f59e0b, 0), linewidth=2, style=plot.style_linebr)
plot(show_levels ? prev_real_val : na, "Real Previous Day VAL", color=color.new(#10b981, 20), linewidth=2, style=plot.style_linebr)

// ==============================================================================
// 3. استخراج ویژگی‌های هم‌زمان بیت‌کوین (BTC CROSS-ASSET MONITOR)
// ==============================================================================
btc_c   = request.security(btc_sym, timeframe.period, close)
btc_o   = request.security(btc_sym, timeframe.period, open)
btc_v   = request.security(btc_sym, timeframe.period, volume)
btc_c15 = request.security(btc_sym, timeframe.period, close[15])
btc_h   = request.security(btc_sym, timeframe.period, high)
btc_l   = request.security(btc_sym, timeframe.period, low)

btc_vel_15m = ((btc_c - btc_c15) / (btc_c15 + 1e-6)) * 100.0
btc_candle_delta = btc_v * ((btc_c - btc_o) / math.max(btc_h - btc_l, 0.001))
btc_delta_5m = ta.sma(btc_candle_delta, 5) / (ta.sma(btc_v, 5) + 1e-6)

// ==============================================================================
// 4. ریزساختار بازار اتریوم و اردر فلو (ETH ORDER FLOW & MICROSTRUCTURE)
// ==============================================================================
eth_candle_delta = volume * ((close - open) / math.max(high - low, 0.001))
eth_delta_5m = ta.sma(eth_candle_delta, 5) / (ta.sma(volume, 5) + 1e-6)
eth_atr = ta.atr(14)
candle_range = math.max(high - low, 0.001)
close_location = (close - low) / candle_range

// ==============================================================================
// 5. موتور تحلیل همگرایی حراج نهادی (AMT CONFLUENCE SCORE)
// ==============================================================================
float score_delta_l = eth_delta_5m > 0 ? 30.0 * math.min(eth_delta_5m / 0.20, 1.0) : 0.0
float score_delta_s = eth_delta_5m < 0 ? 30.0 * math.min(-eth_delta_5m / 0.20, 1.0) : 0.0

float score_btc_l = (btc_vel_15m >= 0 and btc_delta_5m >= 0) ? 30.0 : (btc_vel_15m >= btc_vel_thresh ? 15.0 : 0.0)
float score_btc_s = (btc_vel_15m <= 0 and btc_delta_5m <= 0) ? 30.0 : (btc_vel_15m <= -btc_vel_thresh ? 15.0 : 0.0)

float score_rej_l = close_location >= 0.55 ? 20.0 : (close_location >= 0.35 ? 10.0 : 0.0)
float score_rej_s = close_location <= 0.45 ? 20.0 : (close_location <= 0.65 ? 10.0 : 0.0)

float avg_vol = ta.sma(volume, 20)
float vol_ratio = volume / math.max(avg_vol, 0.001)
float score_vol = vol_ratio >= 1.3 ? 20.0 : (vol_ratio >= 1.0 ? 12.0 : 5.0)

float amt_score_long  = score_delta_l + score_btc_l + score_rej_l + score_vol
float amt_score_short = score_delta_s + score_btc_s + score_rej_s + score_vol

// ==============================================================================
// 6. استاپلاس ساختاری سوئیپ و تارگت‌های چندپله‌ای (SWEEP SL & MULTI-TP)
// ==============================================================================
buffer = eth_atr * atr_sl_mult

// لانگ: تست کف ارزش VAL
is_val_sweep = (low <= prev_real_val) and (close > prev_real_val)
long_entry = close
// استاپ ساختاری: پایین‌ترین قیمت ۳ کندل اخیر منهای بافر نوسانی
long_sl    = ta.lowest(low, sweep_bars) - buffer
long_tp1   = prev_real_poc  // پله اول ۵۰٪ در POC
long_tp2   = prev_real_vah  // پله دوم ۳۰٪ در VAH مخالف رنج

long_risk_dist   = long_entry - long_sl
long_reward_dist = long_tp1 - long_entry
long_rr          = long_reward_dist / math.max(long_risk_dist, 0.001)
long_rr_valid    = (long_rr >= min_rr_ratio) and (long_risk_dist > 0)

// شورت: تست سقف ارزش VAH
is_vah_sweep = (high >= prev_real_vah) and (close < prev_real_vah)
short_entry = close
// استاپ ساختاری: بالاترین قیمت ۳ کندل اخیر به علاوه بافر نوسانی
short_sl    = ta.highest(high, sweep_bars) + buffer
short_tp1   = prev_real_poc  // پله اول ۵۰٪ در POC
short_tp2   = prev_real_val  // پله دوم ۳۰٪ در VAL مخالف رنج

short_risk_dist   = short_sl - short_entry
short_reward_dist = short_entry - short_tp1
short_rr          = short_reward_dist / math.max(short_risk_dist, 0.001)
short_rr_valid    = (short_rr >= min_rr_ratio) and (short_risk_dist > 0)

btc_long_safe  = not btc_filter_on or (btc_vel_15m >= btc_vel_thresh)
btc_short_safe = not btc_filter_on or (btc_vel_15m <= -btc_vel_thresh)

long_approved  = is_val_sweep and long_rr_valid and (amt_score_long >= min_score) and btc_long_safe
short_approved = is_vah_sweep and short_rr_valid and (amt_score_short >= min_score) and btc_short_safe

long_trap_detected  = is_val_sweep and not btc_long_safe
short_trap_detected = is_vah_sweep and not btc_short_safe

// ==============================================================================
// 7. محاسبه اهرم و حجم پوزیشن بر اساس سقف ریسک ۳٪ سرمایه
// ==============================================================================
calc_pos_sizing(entry_p, sl_p) =>
    sl_dist = math.abs(entry_p - sl_p)
    sl_pct  = sl_dist / entry_p
    risk_usd = account_cap * (risk_pct / 100.0)
    pos_usd  = risk_usd / math.max(sl_pct, 0.001)
    qty_eth  = pos_usd / entry_p
    lev      = pos_usd / account_cap
    [pos_usd, qty_eth, lev, risk_usd]

[l_pos_usd, l_qty, l_lev, l_risk] = calc_pos_sizing(long_entry, long_sl)
[s_pos_usd, s_qty, s_lev, s_risk] = calc_pos_sizing(short_entry, short_sl)

// ==============================================================================
// 8. ثبت سیگنال‌ها روی چارت و ترسیم سطوح چندپله‌ای
// ==============================================================================
var int last_trade_bar = 0
min_bars_between = 20

if (long_approved and (bar_index - last_trade_bar > min_bars_between))
    last_trade_bar := bar_index
    label_text = "🟢 ورود لانگ حراج (AMT LONG)" +
                 "\nقیمت ورود: " + str.tostring(long_entry, "#.##") +
                 "\nحد ضرر سوئیپ: " + str.tostring(long_sl, "#.##") +
                 "\nتارگت اول (TP1 - ۵۰٪): " + str.tostring(long_tp1, "#.##") +
                 "\nتارگت دوم (TP2 - ۳۰٪): " + str.tostring(long_tp2, "#.##") +
                 "\nرانر (Runner - ۲۰٪): باز" +
                 "\nنسبت R:R ساختاری: 1:" + str.tostring(long_rr, "#.#") +
                 "\nحجم پوزیشن: " + str.tostring(l_pos_usd, "#") + " $ (" + str.tostring(l_qty, "#.##") + " ETH)" +
                 "\nاهرم مجاز (۳٪): " + str.tostring(l_lev, "#.#") + "x"
    label.new(bar_index, low, label_text, color=color.new(#27ae60, 0), textcolor=color.white,
              style=label.style_label_up, size=size.normal)
    line.new(bar_index, long_tp1, bar_index + 30, long_tp1, color=color.green, width=2, style=line.style_dashed)
    line.new(bar_index, long_tp2, bar_index + 30, long_tp2, color=color.teal, width=2, style=line.style_dashed)
    line.new(bar_index, long_sl, bar_index + 30, long_sl, color=color.red, width=2, style=line.style_dashed)

if (short_approved and (bar_index - last_trade_bar > min_bars_between))
    last_trade_bar := bar_index
    label_text = "🔴 ورود شورت حراج (AMT SHORT)" +
                 "\nقیمت ورود: " + str.tostring(short_entry, "#.##") +
                 "\nحد ضرر سوئیپ: " + str.tostring(short_sl, "#.##") +
                 "\nتارگت اول (TP1 - ۵۰٪): " + str.tostring(short_tp1, "#.##") +
                 "\nتارگت دوم (TP2 - ۳۰٪): " + str.tostring(short_tp2, "#.##") +
                 "\nرانر (Runner - ۲۰٪): باز" +
                 "\nنسبت R:R ساختاری: 1:" + str.tostring(short_rr, "#.#") +
                 "\nحجم پوزیشن: " + str.tostring(s_pos_usd, "#") + " $ (" + str.tostring(s_qty, "#.##") + " ETH)" +
                 "\nاهرم مجاز (۳٪): " + str.tostring(s_lev, "#.#") + "x"
    label.new(bar_index, high, label_text, color=color.new(#c0392b, 0), textcolor=color.white,
              style=label.style_label_down, size=size.normal)
    line.new(bar_index, short_tp1, bar_index + 30, short_tp1, color=color.green, width=2, style=line.style_dashed)
    line.new(bar_index, short_tp2, bar_index + 30, short_tp2, color=color.teal, width=2, style=line.style_dashed)
    line.new(bar_index, short_sl, bar_index + 30, short_sl, color=color.red, width=2, style=line.style_dashed)

var int last_trap_bar = 0
if ((long_trap_detected or short_trap_detected) and (bar_index - last_trap_bar > 15))
    last_trap_bar := bar_index
    trap_msg = long_trap_detected ? "⚠️ تله دامپ بیت‌کوین دفع شد!\n(ورود لانگ مسدود شد)" : "⚠️ تله پامپ بیت‌کوین دفع شد!\n(ورود شورت مسدود شد)"
    label.new(bar_index, long_trap_detected ? low : high, trap_msg,
              color=color.new(#7f8c8d, 10), textcolor=color.white,
              style=long_trap_detected ? label.style_label_up : label.style_label_down,
              size=size.small)

// ==============================================================================
// 9. پنل اطلاعات زنده گوشه چارت (INSTITUTIONAL HEADS-UP DISPLAY - HUD)
// ==============================================================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(#1e222d, 10), border_color=color.gray, border_width=1)

if barstate.islast and show_hud
    table.cell(hud, 0, 0, "سامانه MML AI Sentinel", bgcolor=color.new(#2980b9, 0), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "وضعیت آنی حراج", bgcolor=color.new(#2980b9, 0), text_color=color.white, text_size=size.small)
    
    btc_status_color = btc_vel_15m >= 0 ? color.green : color.red
    table.cell(hud, 0, 1, "شتاب ۱۵دقیقه بیت‌کوین", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(btc_vel_15m, "+#.##") + "%", text_color=btc_status_color, text_size=size.small)
    
    btc_d_color = btc_delta_5m >= 0 ? color.green : color.red
    table.cell(hud, 0, 2, "جریان دلتای بیت‌کوین", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, btc_delta_5m >= 0 ? "خریدار خالص" : "فروشنده خالص", text_color=btc_d_color, text_size=size.small)
    
    table.cell(hud, 0, 3, "تارگت اول TP1 (POC ۵۰٪)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(prev_real_poc, "#.##") + " $", text_color=color.orange, text_size=size.small)
    
    table.cell(hud, 0, 4, "تارگت دوم TP2 (۳۰٪)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(prev_real_vah, "#.#") + " / " + str.tostring(prev_real_val, "#.#"), text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 5, "امتیاز همگرایی حراج (Score)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, str.tostring(math.max(amt_score_long, amt_score_short), "#") + "%", text_color=color.aqua, text_size=size.small)

    table.cell(hud, 0, 6, "سرمایه / سقف ریسک", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, "$" + str.tostring(account_cap, "#") + " | " + str.tostring(risk_pct, "#.#") + "% ($" + str.tostring(account_cap*risk_pct/100, "#") + ")", text_color=color.aqua, text_size=size.small)
    
    table.cell(hud, 0, 7, "حجم مجاز پوزیشن (۳٪)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7, "$" + str.tostring(l_pos_usd, "#") + " (" + str.tostring(l_lev, "#.#") + "x)", text_color=color.aqua, text_size=size.small)

// ==============================================================================
// 10. ارسال وب‌هوک به سرور پایتون برای اعتبارسنجی نهایی و اجرای سفارشات
// ==============================================================================
alertcondition(long_approved, title="سیگنال لانگ حراج اتریوم (تایید هوش مصنوعی)", message='{"symbol":"ETHUSDT","side":1}')
alertcondition(short_approved, title="سیگنال شورت حراج اتریوم (تایید هوش مصنوعی)", message='{"symbol":"ETHUSDT","side":-1}')
alertcondition(long_trap_detected or short_trap_detected, title="هشدار تله سرایت بیت‌کوین", message='{"warning":"BTC Contagion Trap Detected"}')
